            end)
        else
            if _G.FPSConn then _G.FPSConn:Disconnect() _G.FPSConn = nil end
            local existingGui = gethui():FindFirstChild("FPS_Display") or game:GetService("CoreGui"):FindFirstChild("FPS_Display")
            if existingGui then existingGui:Destroy() end
        end
    end, nil, true)

    AddElement(SettingsHolder, "Fix Lag V3 (Graihub)", "button", function()
        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/Graihub/graihubfixlagv3/refs/heads/main/fixlagv3"))()
        end)
    end, 'loadstring(game:HttpGet("https://raw.githubusercontent.com/Graihub/graihubfixlagv3/refs/heads/main/fixlagv3"))()', true)
end

