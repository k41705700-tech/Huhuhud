-- Hàm tạo trái cây giả tồn tại vĩnh viễn và không rơi xuyên map
local function spawnFakeFruit()
	local fruit = Instance.new("Part")
	fruit.Size = Vector3.new(3, 3, 3)
	fruit.Shape = Enum.PartType.Ball
	fruit.Material = Enum.Material.Neon
	fruit.BrickColor = BrickColor.random()
	
	-- Xác định vị trí rơi ngẫu nhiên xung quanh người chơi
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local root = LocalPlayer.Character.HumanoidRootPart
		fruit.Position = root.Position + Vector3.new(math.random(-30, 30), 40, math.random(-30, 30))
	else
		fruit.Position = Vector3.new(0, 50, 0)
	end
	
	-- Cấu hình vật lý
	fruit.CanCollide = true
	fruit.Anchored = false
	fruit.Parent = Workspace
	
	-- Xử lý sự kiện: Khi chạm đất hoặc vật cản sẽ cố định vị trí vĩnh viễn ở đó
	local connection
	connection = fruit.Touched:Connect(function(hit)
		if hit and hit.Parent and not hit:IsDescendantOf(LocalPlayer.Character) then
			fruit.Anchored = true
			if connection then
				connection:Disconnect()
			end
		end
	end)
end

-- Kích hoạt chức năng khi bấm nút (Mỗi lần bấm tạo ra 15 quả trái cây vĩnh viễn)
RainBtn.MouseButton1Click:Connect(function()
