            local uc = Instance.new("UICorner", T_Up) uc.CornerRadius = UDim.new(1,0)

            local T_Down = Instance.new("TextButton")
            T_Down.Parent = FlyGui
            T_Down.BackgroundColor3 = Color3.fromRGB(0, 120, 240)
            T_Down.Position = UDim2.new(1, -110, 0.5, -30)
            T_Down.Size = UDim2.new(0, 50, 0, 50)
            T_Down.Font = Enum.Font.GothamBold
            T_Down.Text = "▼"
            T_Down.TextColor3 = Color3.fromRGB(255, 255, 255)
            T_Down.TextSize = 20
            local dc = Instance.new("UICorner", T_Down) dc.CornerRadius = UDim.new(1,0)

            local movingUp, movingDown = false, false
            T_Up.MouseButton1Down:Connect(function() movingUp = true end)
            T_Up.MouseButton1Up:Connect(function() movingUp = false end)
            T_Down.MouseButton1Down:Connect(function() movingDown = true end)
            T_Down.MouseButton1Up:Connect(function() movingDown = false end)

            flyConn = RunService.RenderStepped:Connect(function()
                if not _G.FlyEnabled then return end
                local char = Player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                    local hrp = char.HumanoidRootPart
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    
                    local bv = hrp:FindFirstChild("HuhuHub_Fly_BV")
                    local bg = hrp:FindFirstChild("HuhuHub_Fly_BG")

                    if not bv then
                        bv = Instance.new("BodyVelocity")
                        bv.Name = "HuhuHub_Fly_BV"
                        bv.Parent = hrp
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
