    local function CreateTab(tabName)
        local TabBtn = Instance.new("TextButton")
        TabBtn.Parent = TabBar
        TabBtn.BackgroundColor3 = Color3.fromRGB(20, 30, 50)
        TabBtn.Size = UDim2.new(1, 0, 0, 38)
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.Text = "  " .. tabName
        TabBtn.TextColor3 = Color3.fromRGB(160, 190, 230)
        TabBtn.TextSize = 12
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left

        local TCorner = Instance.new("UICorner")
        TCorner.CornerRadius = UDim.new(0, 6)
        TCorner.Parent = TabBtn

        local PageFrame = Instance.new("ScrollingFrame")
        PageFrame.Parent = Container
        PageFrame.BackgroundTransparency = 1
        PageFrame.Size = UDim2.new(1, 0, 1, 0)
        PageFrame.CanvasSize = UDim2.new(0, 0, 0, 800)
        PageFrame.ScrollBarThickness = 3
        PageFrame.Visible = false

        local ContentListHolder = Instance.new("Frame")
        ContentListHolder.Parent = PageFrame
        ContentListHolder.BackgroundTransparency = 1
        ContentListHolder.Size = UDim2.new(1, 0, 0, 750)

        local HolderLayout = Instance.new("UIListLayout")
        HolderLayout.Parent = ContentListHolder
        HolderLayout.SortOrder = Enum.SortOrder.LayoutOrder
        HolderLayout.Padding = UDim.new(0, 8)

        MainSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local query = string.lower(MainSearchBox.Text)
            if query == "" then
                for _, item in pairs(ContentListHolder:GetChildren()) do
                    if item:IsA("GuiObject") then item.Visible = true end
                end
                return
            end

            local children = ContentListHolder:GetChildren()
            local sectionHeaderInstance = nil
            local itemsInCurrentSection = 0

            for _, item in pairs(children) do
                if item:IsA("GuiObject") then
                    if item.Name == "SectionHeader" then
                        if sectionHeaderInstance and itemsInCurrentSection == 0 then
                            sectionHeaderInstance.Visible = false
                        end
                        sectionHeaderInstance = item
                        itemsInCurrentSection = 0
                        item.Visible = true
                    elseif item.Name == "ScriptItem" or item.Name == "SettingItem" then
                        local nameLbl = item:FindFirstChild("ItemName", true)
                        if nameLbl then
                            local name = string.lower(nameLbl.Text)
                            if string.find(name, query) then
                                item.Visible = true
                                itemsInCurrentSection = itemsInCurrentSection + 1
                            else
                                item.Visible = false
                            end
                        end
                    end
                end
            end
            if sectionHeaderInstance and itemsInCurrentSection == 0 then
                sectionHeaderInstance.Visible = false
            end
        end)

        if firstTab then
            PageFrame.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(0, 110, 230)
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            firstTab = false
        end

        TabBtn.MouseButton1Click:Connect(function()
            for _, p in pairs(pages) do p.Visible = false end
            for _, b in pairs(TabBar:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = Color3.fromRGB(20, 30, 50)
                    b.TextColor3 = Color3.fromRGB(160, 190, 230)
                end
            end
            PageFrame.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(0, 110, 230)
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)

        table.insert(pages, PageFrame)
        return ContentListHolder
    end

    local function AddElement(holder, name, typeStyle, callback, rawScriptCode, isSetting)
        local MainItemFrame = Instance.new("Frame")
        MainItemFrame.Parent = holder
        MainItemFrame.BackgroundTransparency = 1
        MainItemFrame.Size = UDim2.new(1, -15, 0, 36)
        MainItemFrame.Name = isSetting and "SettingItem" or "ScriptItem"

        if typeStyle == "section" then
