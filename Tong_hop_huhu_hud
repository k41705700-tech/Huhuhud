            MainItemFrame.Size = UDim2.new(1, -15, 0, 26)
            
            local SecLbl = Instance.new("TextLabel")
            SecLbl.Name = "ItemName"
            SecLbl.Parent = MainItemFrame
            SecLbl.BackgroundTransparency = 1
            SecLbl.Size = UDim2.new(1, 0, 1, 0)
            SecLbl.Font = Enum.Font.GothamBold
            SecLbl.Text = name
            SecLbl.TextColor3 = Color3.fromRGB(100, 180, 255)
            SecLbl.TextSize = 11
            SecLbl.TextXAlignment = Enum.TextXAlignment.Center
            return
        end

        local hideCopy = (rawScriptCode == nil)
        local btnWidthOffset = hideCopy and 0 or -40
        local Btn = Instance.new("TextButton")
        Btn.Parent = MainItemFrame
        Btn.BackgroundColor3 = Color3.fromRGB(18, 28, 48)
        Btn.Size = UDim2.new(1, btnWidthOffset, 1, 0)
        Btn.Font = Enum.Font.GothamBold
        Btn.Text = ""
        Btn.TextColor3 = Color3.fromRGB(210, 230, 255)

        local BCorner = Instance.new("UICorner")
        BCorner.CornerRadius = UDim.new(0, 6)
        BCorner.Parent = Btn

        local NameLbl = Instance.new("TextLabel")
        NameLbl.Name = "ItemName"
        NameLbl.Parent = Btn
        NameLbl.BackgroundTransparency = 1
        NameLbl.Position = UDim2.new(0, 10, 0, 0)
        NameLbl.Size = UDim2.new(1, -15, 1, 0)
        NameLbl.Font = Enum.Font.GothamBold
        NameLbl.Text = name
        NameLbl.TextColor3 = Color3.fromRGB(210, 230, 255)
        NameLbl.TextSize = 11
        NameLbl.TextXAlignment = Enum.TextXAlignment.Left
        NameLbl.TextTruncate = Enum.TextTruncate.AtEnd

        if not hideCopy then
            local CopyBtn = Instance.new("TextButton")
            CopyBtn.Parent = MainItemFrame
            CopyBtn.BackgroundColor3 = Color3.fromRGB(20, 40, 70)
            CopyBtn.Position = UDim2.new(1, -32, 0, 0)
            CopyBtn.Size = UDim2.new(0, 32, 1, 0)
            CopyBtn.Font = Enum.Font.GothamBold
            CopyBtn.Text = "📋"
            CopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            CopyBtn.TextSize = 12

            local CCorn = Instance.new("UICorner")
            CCorn.CornerRadius = UDim.new(0, 6)
            CCorn.Parent = CopyBtn

            CopyBtn.MouseButton1Click:Connect(function()
                pcall(function() setclipboard(rawScriptCode) end)
                CopyBtn.Text = "✔"
                task.wait(1)
                CopyBtn.Text = "📋"
            end)
        end

        if typeStyle == "toggle" then
            local active = false
            NameLbl.Text = "[ OFF ] " .. name
            Btn.MouseButton1Click:Connect(function()
                active = not active
                if active then
                    NameLbl.Text = "[ ON ] " .. name
                    Btn.BackgroundColor3 = Color3.fromRGB(0, 120, 240)
                else
                    NameLbl.Text = "[ OFF ] " .. name
                    Btn.BackgroundColor3 = Color3.fromRGB(18, 28, 48)
                end
                pcall(function() callback(active, Btn, NameLbl) end)
            end)
        elseif typeStyle == "button" then
            Btn.BackgroundColor3 = Color3.fromRGB(15, 50, 100)
            Btn.MouseButton1Click:Connect(function()
                pcall(function() callback() end)
            end)
        end
    end

