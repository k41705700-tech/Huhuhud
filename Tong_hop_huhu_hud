    AddElement(SettingsHolder, "Bay Tự Do (Fly)", "toggle", function(v)
        _G.FlyEnabled = v
        local cam = workspace.CurrentCamera
        local speed = 290

        if _G.FlyEnabled then
            if FlyGui then FlyGui:Destroy() end
            FlyGui = Instance.new("ScreenGui")
            FlyGui.Name = "HuhuHub_FlyControls"
            FlyGui.ResetOnSpawn = false
            ProtectGui(FlyGui)

            local T_Up = Instance.new("TextButton")
            T_Up.Parent = FlyGui
            T_Up.BackgroundColor3 = Color3.fromRGB(0, 120, 240)
            T_Up.Position = UDim2.new(1, -110, 0.5, -90)
            T_Up.Size = UDim2.new(0, 50, 0, 50)
