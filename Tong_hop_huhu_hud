                    local ping = 0
                    pcall(function()
                        ping = math.floor(Player:GetNetworkPing() * 1000 + 0.5)
                    end)
                    lbl.Text = "FPS: " .. fps .. " | Ping: " .. ping .. "ms"
                end
            end)
        else
            if _G.FPSConn then _G.FPSConn:Disconnect() _G.FPSConn = nil end
            local existingGui = gethui():FindFirstChild("FPS_Display") or game:GetService("CoreGui"):FindFirstChild("FPS_Display")
