            T_Up.MouseButton1Down:Connect(function() movingUp = true end)
            T_Up.MouseButton1Up:Connect(function() movingUp = false end)
            T_Down.MouseButton1Down:Connect(function() movingDown = true end)
            T_Down.MouseButton1Up:Connect(function() movingDown = false end)

            flyConn = RunService.RenderStepped:Connect(function(dt)
                if not _G.FlyEnabled then return end
                local char = Player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                    local hrp = char.HumanoidRootPart
                    local hum = char:FindFirstChildOfClass("Humanoid")

                    local bv = hrp:FindFirstChild("HuhuHub_Fly_BV")
                    local bg = hrp:FindFirstChild("HuhuHub_Fly_BG")

                    if not bv then
                        bv = Instance.new("LinearVelocity")
                        bv.Name = "HuhuHub_Fly_BV"
                        bv.Parent = hrp
                        bv.MaxForce = 9e9

                        local att = Instance.new("Attachment", hrp)
                        att.Name = "HuhuHub_Att"
                        bv.Attachment0 = att

                        bg = Instance.new("BodyGyro")
                        bg.Name = "HuhuHub_Fly_BG"
                        bg.Parent = hrp
                        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                        bg.P = 20000
                    end

                    hum.PlatformStand = true

                    local moveDir = hum.MoveDirection * speed
                    local yVel = 0
                    if movingUp then yVel = speed elseif movingDown then yVel = -speed end

                    local targetVel = Vector3.new(moveDir.X, yVel, moveDir.Z)
                    if hrp:FindFirstChild("HuhuHub_Fly_BV") then
                        hrp.HuhuHub_Fly_BV.VectorVelocity = hrp.HuhuHub_Fly_BV.VectorVelocity:Lerp(targetVel, math.clamp(dt * 15, 0, 1))
                    end
                    bg.CFrame = cam.CFrame
                end
            end)
        else
