textLabel.Font = Enum.Font.SourceSansBold -- Font chữ đậm, dễ đọc
textLabel.Text = "BẠN ĐÃ BỊ BAN" -- Nội dung chính
textLabel.ZIndex = 2 -- Hiển thị trên lớp nền đen
